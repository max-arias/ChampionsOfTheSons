<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!-- RedLoader 0.8.6 runs mods on .NET 6, which is out of support; building for it is intended. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- Sons of the Forest install folder. Override with -p:GameDir=... or a .csproj.user file. -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Sons Of The Forest</GameDir>
  </PropertyGroup>
</Project>
